<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>c918c6fc-e1ae-4f1d-a0c0-c8e3bd0b92a6</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>FinAccrual</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="FinAccrual"/>
  <Description DefaultValue="Connect, automate, and sync QuickBooks and Xero ERP accounting data directly with Excel."/>
  <IconUrl DefaultValue="https://addin.finaccrual.com/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://addin.finaccrual.com/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://finaccrual.com/support"/>
  <AppDomains>
    <AppDomain>https://api.finaccrual.com</AppDomain>
    <AppDomain>https://addin.finaccrual.com</AppDomain>
    <AppDomain>https://appcenter.intuit.com</AppDomain>
    <AppDomain>https://login.xero.com</AppDomain>
    <AppDomain>https://identity.xero.com</AppDomain>
    <AppDomain>https://accounts.google.com</AppDomain>
    <AppDomain>https://oauth2.googleapis.com</AppDomain>
    <AppDomain>https://www.googleapis.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://addin.finaccrual.com/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="FinAccrualCommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="FinAccrualTaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>FinAccrualTaskpaneId</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://addin.finaccrual.com/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://addin.finaccrual.com/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://addin.finaccrual.com/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://finaccrual.com/docs"/>
        <bt:Url id="Commands.Url" DefaultValue="https://addin.finaccrual.com/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://addin.finaccrual.com/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with FinAccrual"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="FinAccrual"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="FinAccrual Taskpane"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Sync and automate your ERP journals and master data in Excel."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open FinAccrual to connect QuickBooks or Xero and sync sheets."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
